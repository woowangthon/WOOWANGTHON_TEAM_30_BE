# 여운 로컬 개발 설정 예시. 복사해서 .env로 쓰세요(.env는 커밋되지 않아요).
#   cp .env.example .env
# 서버는 YEOUN_ 으로 시작하는 변수만 읽어요. (ANTHROPIC_API_KEY 같은 공급자 기본 변수는 읽지 않아요.)

# --- 기본 ---
YEOUN_ENV=development
YEOUN_DATABASE_URL=postgresql+psycopg://yeoun:yeoun@localhost:5432/yeoun
# 비워 두면 개발용 키를 .data/master.key에 만들어 써요. staging/production에서는 꼭 필요해요.
# 만들기: python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
YEOUN_MASTER_KEY=
YEOUN_SESSION_SECRET=

# --- 저장소: local(개발) | db(Render 무료 시연) | s3(R2 등 실사용) ---
YEOUN_STORAGE=local
# YEOUN_S3_BUCKET=
# YEOUN_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# YEOUN_S3_REGION=auto
# YEOUN_S3_ACCESS_KEY_ID=
# YEOUN_S3_SECRET_ACCESS_KEY=

# --- 작업 처리: true면 API 프로세스 안 스레드, false면 `python -m app.worker`를 따로 실행 ---
YEOUN_WORKER_INLINE=true

# --- 검색: auto | kiwi(정확, 메모리 약 350MB) | lite(가벼움) ---
YEOUN_TOKENIZER=auto

# --- AI 공급자: auto면 키가 있는 실제 공급자, 없으면 mock(규칙)/none ---
# auto | mock | openai | gemini
YEOUN_STT_PROVIDER=auto
# auto | none | mock | openai
YEOUN_DIARIZATION_PROVIDER=auto
# auto | mock | anthropic | openai | gemini | replay
YEOUN_LLM_PROVIDER=auto
# auto | none | openai | gemini
YEOUN_EMBEDDING_PROVIDER=auto
YEOUN_ANTHROPIC_API_KEY=
YEOUN_OPENAI_API_KEY=
YEOUN_GEMINI_API_KEY=
# free(입력을 학습에 쓸 수 있음) | paid
YEOUN_GEMINI_TIER=free
# YEOUN_ANTHROPIC_MODEL=claude-haiku-5-5

# --- 링크 주소(녹음·초대). 비우면 브라우저 주소를 써요 ---
YEOUN_PUBLIC_WEB_URL=

# --- 친구 테스트(staging) 제한 ---
# YEOUN_INVITE_CODES=hello-friends,another-code
# YEOUN_MAX_FILE_MB=25
# YEOUN_SPACE_QUOTA_MB=150
# YEOUN_USER_UPLOAD_QUOTA_MB=300
# YEOUN_CHAT_DAILY_LIMIT=150

# --- 웹(Next.js): API 서버 주소 (rewrites 대상) ---
YEOUN_API_ORIGIN=http://localhost:8000
