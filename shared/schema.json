          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "grounded_ratio": {
          "type": [
            "number",
            "null"
          ],
          "description": "근거 클립이 붙은 문단 비율"
